# ==============================================================================
# Kisan Vikas — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit the actual .env file with secrets to source control.
# ==============================================================================

# Server & Networking
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# PostgreSQL Database Connection
DB_USER=postgres
DB_HOST=localhost
DB_NAME=kisan_queue
DB_PASSWORD=your_postgres_password_here
DB_PORT=5432
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/kisan_queue

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# FastAGI & IVR Telephony (Extension 2000)
NEW_IVR_TEST_PHONE=9876543210
FASTAGI_EXT2000_PORT=4574
FASTAGI_HOST=0.0.0.0

# LLM Providers (Multi-Provider NLU Chain: Gemini -> Groq -> OpenRouter -> Offline Rules)
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_API_KEY=your_gemini_api_key_here
AI_ENABLE_OFFLINE_FALLBACK=true
AI_TIMEOUT_MS=8000

GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# Speech Recognition (Primary: Bhashini Udyat ASR / Fallback: Sarvam STT)
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_UDYAT_KEY=your_bhashini_udyat_key_here
BHASHINI_INFERENCE_KEY=your_bhashini_inference_key_here
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
BHASHINI_ASR_ENABLED=true
BHASHINI_TIMEOUT_MS=15000

SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_ENABLED=true
SARVAM_STT_MODEL=saaras:v3
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_TIMEOUT_MS=15000
